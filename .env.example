# ==============================================================================
# Frontend Environment Configuration (TanStack Start / Nitro)
# ==============================================================================

# URL Backend API publik
# Di production: BISA DIKOSONGKAN atau gunakan path relatif jika melalui reverse proxy cPanel.
# Jika backend di-host di subdomain terpisah, isi dengan URL subdomain:
# Contoh: VITE_API_BASE_URL=https://api.restubumibersama.co.id
# Kosongkan jika backend dan frontend berada dalam 1 domain yang sama:
VITE_API_BASE_URL=

# URL Canonical Website Publik
VITE_SITE_URL=https://restubumibersama.co.id

# Internal API URL untuk SSR di server Node (default: http://127.0.0.1:4000)
INTERNAL_API_URL=http://127.0.0.1:4000

# Port untuk Frontend Nitro SSR (default 3000)
PORT=3000
NITRO_PORT=3000
HOST=0.0.0.0
