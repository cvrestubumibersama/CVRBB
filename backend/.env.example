# ==============================================================================
# Backend Environment Configuration (Express API)
# ==============================================================================

# Database Connection (Di cPanel biasanya menggunakan prefix username cPanel)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=rbb

# Port untuk Backend Express (Default 4000)
PORT=4000

# CORS Allowed Origins
# Pisahkan dengan koma jika ada lebih dari 1 domain (misal: dengan dan tanpa www)
CORS_ORIGIN=https://cvrestubumibersama.com,https://www.cvrestubumibersama.com,http://localhost:3000,http://localhost:5173

# Secret Key untuk JWT Auth Admin (Ganti dengan string acak yang aman di production)
JWT_SECRET=rbb_production_jwt_secret_key_change_me_in_production
